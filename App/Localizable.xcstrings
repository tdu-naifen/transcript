    "Your paired Mac is offline. Reconnect before submitting a new task." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已配对的 Mac 当前离线。提交新任务前请重新连接。" } } } },
    "Verifying the Mac's identity and connection." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在验证 Mac 身份及连接。" } } } },
