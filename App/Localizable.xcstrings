    "Transcript uses your local network to discover your Mac and transfer meeting audio and results. iOS may ask for local network access." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Transcript 使用本地网络发现 Mac 并传输会议音频和结果。iOS 可能会请求本地网络访问权限。" } } } },
    "Mac connection is unavailable because this app has no transport service configured." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此 App 尚未配置传输服务，因此暂时无法连接 Mac。" } } } },
    "Open Transcript on your Mac, then look for it on your local network." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请在 Mac 上打开 Transcript，然后在本地网络中查找。" } } } },
    "Keep Transcript open on your Mac. Discovered devices appear here." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请保持 Mac 上的 Transcript 打开。发现的设备会显示在这里。" } } } },
