{
  "sourceLanguage" : "en",
  "strings" : {
    "Mac storage unavailable" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 存储不可用" } } } },
    "Mac is busy" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 正忙" } } } },
    "Copy connection interrupted" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "副本传输连接已中断" } } } },
    "iPhone storage unavailable" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iPhone 存储不可用" } } } },
    "Meeting is still processing" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议仍在处理中" } } } },
    "Copy could not be verified" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法验证副本" } } } },
    "Meeting copy needs attention" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议副本需要处理" } } } },
    "The Mac could not save the copy. Free space or resolve storage access on the Mac, then reconnect and retry." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 无法保存副本。请释放 Mac 存储空间或修复存储访问权限，然后重新连接并重试。" } } } },
    "The Mac is busy. Wait for its current work to finish, then reconnect and retry." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 正忙。请等待当前任务完成，然后重新连接并重试。" } } } },
    "The connection was interrupted before the copy was confirmed. Reconnect to your Mac and retry the saved copy." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "副本确认前连接已中断。请重新连接 Mac，并重试已保存的副本。" } } } },
    "The iPhone could not save meeting-copy state. Check available storage, then retry. Delivery is not confirmed." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iPhone 无法保存会议副本状态。请检查可用存储空间后重试。尚未确认送达。" } } } },
    "This meeting is still being processed on iPhone. Wait for transcription and speaker analysis to finish, then send the copy." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此会议仍在 iPhone 上处理中。请等待转录和说话人分析完成后再发送副本。" } } } },
    "The copy could not be verified. Check the recording and update Transcript on both devices before trying again." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法验证副本。请检查录音并更新两台设备上的 Transcript 后再试。" } } } },
    "The saved copy queue is full. No existing copy or receipt was removed." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已保存的副本队列已满。未移除任何现有副本或回执。" } } } },
    "This meeting already has a saved copy for this Mac. Review its status instead of creating another copy." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此会议已有发送到该 Mac 的已保存副本。请查看其状态，不要创建另一个副本。" } } } },
    "The original recording is unavailable for copying. Check that it is still saved on this iPhone." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "原始录音无法用于复制。请确认录音仍保存在此 iPhone 上。" } } } },
    "Another meeting copy is being prepared or sent. Wait for it to finish." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "另一个会议副本正在准备或发送中。请等待其完成。" } } } },
    "The meeting copy failed for an unknown reason. Review both devices before retrying; delivery is not confirmed." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议副本因未知原因失败。请检查两台设备后再重试；尚未确认送达。" } } } },
    "The iPhone could not save the transfer error. This status may be lost after closing the app. Check storage before retrying; the Mac may retain a copy." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iPhone 无法保存传输错误。关闭应用后此状态可能丢失。请检查存储空间后再重试；Mac 可能仍保留副本。" } } } },
    "The Mac already has this meeting or its deletion record. Nothing was overwritten." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 已有此会议或其删除记录。未覆盖任何内容。"
