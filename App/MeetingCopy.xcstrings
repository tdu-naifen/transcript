{
  "sourceLanguage" : "en",
  "strings" : {
    "Release to submit" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Release to submit" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "松开以提交" } } } },
    "Review compatible copy" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "确认兼容副本" } } } },
    "Send compatible copy" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "发送兼容副本" } } } },
    "Cancel copy" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消复制" } } } },
    "Identifiers to convert" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需转换的标识符数量" } } } },
    "Only transcript identifiers will change in the Mac copy. Your original identifiers, text, times, source, revision and audio on iPhone will not change. Nothing has been queued or sent." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅 Mac 副本中的转录标识符会改变。iPhone 上的原始标识符、文本、时间、来源、修订版本和音频均保持不变。目前尚未加入队列或发送。" } } } },
    "This older Apple transcript needs compatible identifiers in its Mac copy. Review and confirm the identifier-only conversion before sending. The original meeting stays unchanged." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这份较早的 Apple 转录需要在 Mac 副本中使用兼容标识符。发送前请确认仅转换标识符。原始会议保持不变。" } } } },
    "The meeting or destination changed since the compatibility preview. Nothing was sent. Send again to review a new preview before confirming." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议或目标设备已在兼容性预览后发生变化。未发送任何内容。请再次发送以查看新预览后再确认。" } } } },
    "The replacement transcript has invalid times or extends beyond this meeting's saved recording duration. Your previous transcript, speaker assignments and original audio were kept. Keep this meeting and report it for repair before reprocessing again." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "替换转录的时间无效或超出此会议已保存录音的时长。之前的转录、说话人分配和原始音频均已保留。请保留此会议并报告修复后再重新处理。" } } } },
    "Copy compatibility check failed" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "副本兼容性检查失败" } } } },
    "Could not read meeting snapshot" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取会议快照" } } } },
    "Original audio verification failed" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "原始音频验证失败" } } } },
    "Transcript cannot be copied" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法复制转录文本" } } } },
    "Meeting details cannot be copied" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法复制会议详情" } } } },
    "Could not save copy on iPhone" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法在 iPhone 上保存待发送副本" } } } },
    "Mac copy offer was not accepted" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 未接受副本发送请求" } } } },
    "Saved copy progress could not be verified" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法验证副本的已保存进度" } } } },
    "Copy chunk was not acknowledged" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "副本数据块未获确认" } } } },
    "Mac copy receipt was not confirmed" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 副本回执未获确认" } } } },
    "Could not save Mac copy receipt" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法保存 Mac 副本回执" } } } },
    "The connection was interrupted while checking copy compatibility. Reconnect to your Mac and send again. No meeting data was offered." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检查副本兼容性时连接已中断。请重新连接 Mac 后再次发送。尚未向 Mac 提交会议数据。" } } } },
    "The Mac's saved audio or transcript progress does not match this frozen copy. Reconnect and retry; if this repeats, keep both copies and report the mismatch." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 上已保存的音频或转录进度与此冻结副本不匹配。请重新连接并重试；若再次发生，请保留两端副本并报告此问题。" } } } },
    "The Mac did not acknowledge the expected chunk, byte offset and checksum. Reconnect and retry the saved copy. Delivery is not confirmed." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 未确认预期的数据块、字节偏移量和校验值。请重新连接并重试已保存的副本。尚未确认送达。" } } } },
    "The Mac did not return a valid receipt matching this copy and manifest. Reconnect and retry the saved copy to request its receipt. Delivery is not confirmed." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 未返回与此副本及清单匹配的有效回执。请重新连接并重试已保存的副本以获取回执。尚未确认送达。" } } } },
    "The saved meeting or copy queue could not be read on this iPhone. Check storage access and reopen Transcript before sending again." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取此 iPhone 上已保存的会议或副本队列。请检查存储访问权限并重新打开 Transcript 后再次发送。" } } } },
    "The copy data or Mac response failed validation. Review the failed stage on both devices before retrying. Delivery is not confirmed." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "副本数据或 Mac 响应未通过验证。重试前请检查两台设备上的失败阶段。尚未确认送达。" } } } },
    "The original audio could not be read. Check that the recording plays on this iPhone and that storage is accessible, then retry." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取原始音频。请确认录音可在此 iPhone 上播放且存储可访问，然后重试。" } } } },
    "The original audio does not match its saved byte count or checksum. Keep the recording and report this meeting for repair; no replacement audio was created." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "原始音频与已保存的字节数或校验值不匹配。请保留录音并报告此会议以便修复；未创建替代音频。" } } } },
    "A transcript segment is outside the saved recording duration or has an invalid time range. Keep this meeting and report it for repair before sending again. No times or audio were changed." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "某段转录超出已保存录音的时长或时间范围无效。请保留此会议并报告修复后再发送。未更改任何时间或音频。" } } } },
    "The transcript contains an unsupported or duplicate identifier. Keep this meeting and report it for repair before sending again." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "转录包含不支持或重复的标识符。请保留此会议并报告修复后再发送。" } } } },
    "The transcript contains unsupported source or revision information. Keep this meeting and report it for repair before sending again." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "转录包含不支持的来源或修订信息。请保留此会议并报告修复后再发送。" } } } },
    "The transcript exceeds copy limits or contains unsupported text or language data. Keep this meeting and report it for repair before sending again." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "转录超出副本限制，或包含不支持的文本或语言数据。请保留此会议并报告修复后再发送。" } } } },
    "The saved meeting metadata is not supported by meeting copy. Check the title, language and dates, and report this meeting for repair if needed." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已保存的会议元数据不受会议副本支持。请检查标题、语言和日期，必要时报告此会议以便修复。" } } } },
    "Copy compatibility or the paired Mac identity could not be confirmed. Check the paired Mac and its copy support, then discover and reconnect." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法确认副本兼容性或已配对 Mac 的身份。请检查配对的 Mac 及其副本支持，然后重新发现并连接。" } } } },
    "Apple transcription returned a time range outside its audio input. The recording is preserved; report this meeting for repair." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Apple 转录返回了超出输入音频的时间范围。录音已保留；请报告此会议以便修复。" } } } },
    "Mac storage unavailable" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 存储不可用" } } } },
    "Mac is busy" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 正忙" } } } },
    "Copy connection interrupted" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "副本传输连接已中断" } } } },
    "iPhone storage unavailable" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iPhone 存储不可用" } } } },
    "Meeting is still processing" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议仍在处理中" } } } },
    "Copy could not be verified" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法验证副本" } } } },
    "Meeting copy needs attention" : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议副本需要处理" } } } },
    "The Mac could not save the copy. Free space or resolve storage access on the Mac, then reconnect and retry." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 无法保存副本。请释放 Mac 存储空间或修复存储访问权限，然后重新连接并重试。" } } } },
    "The Mac is busy. Wait for its current work to finish, then reconnect and retry." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 正忙。请等待当前任务完成，然后重新连接并重试。" } } } },
    "The connection was interrupted before the copy was confirmed. Reconnect to your Mac and retry the saved copy." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "副本确认前连接已中断。请重新连接 Mac，并重试已保存的副本。" } } } },
    "The iPhone could not save meeting-copy state. Check available storage, then retry. Delivery is not confirmed." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iPhone 无法保存会议副本状态。请检查可用存储空间后重试。尚未确认送达。" } } } },
    "This meeting is still being processed on iPhone. Wait for transcription and speaker analysis to finish, then send the copy." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此会议仍在 iPhone 上处理中。请等待转录和说话人分析完成后再发送副本。" } } } },
    "The saved copy queue is full. No existing copy or receipt was removed." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已保存的副本队列已满。未移除任何现有副本或回执。" } } } },
    "This meeting already has a saved copy for this Mac. Review its status instead of creating another copy." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此会议已有发送到该 Mac 的已保存副本。请查看其状态，不要创建另一个副本。" } } } },
    "The original recording is unavailable for copying. Check that it is still saved on this iPhone." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "原始录音无法用于复制。请确认录音仍保存在此 iPhone 上。" } } } },
    "Another meeting copy is being prepared or sent. Wait for it to finish." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "另一个会议副本正在准备或发送中。请等待其完成。" } } } },
    "The meeting copy failed for an unknown reason. Review both devices before retrying; delivery is not confirmed." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议副本因未知原因失败。请检查两台设备后再重试；尚未确认送达。" } } } },
    "The iPhone could not save the transfer error. This status may be lost after closing the app. Check storage before retrying; the Mac may retain a copy." : { "extractionState" : "manual", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iPhone 无法保存传输错误。关闭应用后此状态可能丢失。请检查存储空间后再重试；Mac 可能仍保留副本。" } } } },
    "The Mac already has this meeting or its deletion record. Nothing was overwritten." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 已有此会议或其删除记录。未覆盖任何内容。"
          }
        }
      }
    },
    "Checking and saving copy…" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在检查并保存副本…"
          }
        }
      }
    },
    "Could not read the saved meeting-copy queue." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取已保存的会议副本队列。"
          }
        }
      }
    },
    "Immutable copy saved on Mac" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不可变副本已保存在 Mac 上"
          }
        }
      }
    },
    "Keep Transcript open while sending. Interrupted copies stay queued for explicit retry." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送时请保持 Transcript 打开。中断的副本会保留在队列中，等待你手动重试。"
          }
        }
      }
    },
    "Meeting copy was not confirmed. Update Transcript on the Mac if needed, then reconnect and retry. Your saved Mac identity is unchanged." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会议副本尚未确认。必要时请更新 Mac 上的 Transcript，然后重新连接并重试。已保存的 Mac 身份保持不变。"
          }
        }
      }
    },
    "Ready to receive an immutable meeting copy. Processing and result sync are not included." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以接收不可变会议副本。不包含处理或结果同步。"
          }
        }
      }
    },
    "Securely paired. Send checks compatibility before sharing meeting data." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安全配对。发送前会先检查兼容性，之后才会共享会议数据。"
          }
        }
      }
    },
    "Send a copy to Mac" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送副本到 Mac"
          }
        }
      }
    },
    "Send copy" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送副本"
          }
        }
      }
    },
    "Send sealed audio and the current transcript as a new immutable meeting copy. No overwrite, processing, or result sync is included." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将已封存的音频和当前转录发送为新的不可变会议副本。不覆盖已有会议，也不包含处理或结果同步。"
          }
        }
      }
    },
    "Stop sending on iPhone" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上停止发送"
          }
        }
      }
    },
    "Stopped on iPhone · Mac may retain a copy" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在 iPhone 上停止 · Mac 可能仍保留副本"
          }
        }
      }
    },
    "The meeting changed after export. This frozen copy cannot be sent." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出后会议已更改。无法发送此已冻结的副本。"
          }
        }
      }
    },
    "Update Transcript on the Mac to receive meeting copies, then discover and reconnect." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请更新 Mac 上的 Transcript 以接收会议副本，然后重新查找并连接。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}