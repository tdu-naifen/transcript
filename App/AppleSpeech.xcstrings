      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在准备 Apple 语言资源。本次录音仅保存音频；资源就绪后，下次录音即可转写。"
          }
        }
      }
    },
